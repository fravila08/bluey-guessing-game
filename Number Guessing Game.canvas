		{"id":"flowtitle","type":"text","text":"# 🔄 How the game flows","x":-1050,"y":1580,"width":700,"height":60,"color":"5"},
		{"id":"f0","type":"text","text":"**Page load**\n`startGame()`","x":-1050,"y":1700,"width":330,"height":130,"color":"5"},
		{"id":"f1","type":"text","text":"**Player submits a guess**\nEnter or Guess!","x":-600,"y":1700,"width":330,"height":130,"color":"2"},
		{"id":"f2","type":"text","text":"**Checks**\nrepeat guard → valid? → duplicate?\n(rejects don't cost a guess)","x":-150,"y":1700,"width":330,"height":130,"color":"6"},
		{"id":"f3","type":"text","text":"**Counted guess**\n`guessesLeft--`\nhigh / low / correct","x":300,"y":1700,"width":330,"height":130,"color":"6"},
		{"id":"fwin","type":"text","text":"**🎉 Correct** → `endGame(true)`\n\"Wackadoo! You guessed my number!\"","x":750,"y":1580,"width":330,"height":110,"color":"4"},
		{"id":"flose","type":"text","text":"**😢 0 guesses left** → `endGame(false)`\nShows the correct number","x":750,"y":1840,"width":330,"height":110,"color":"1"},
		{"id":"fpop","type":"text","text":"**Pop-up opens**\nInput & button disabled","x":1200,"y":1700,"width":330,"height":130,"color":"3"},
		{"id":"fclose","type":"text","text":"**Pop-up closes**\nPlay again (after 400 ms) · Esc · backdrop click","x":1200,"y":1950,"width":330,"height":130,"color":"3"},
		{"id":"legend","type":"text","text":"### Legend\n**Tree:** 🔴 index.html · 🟢 style.css · 🟣 script.js · 🟡 documentation · 🔵 project root\n**Flow:** 🔵 start · 🟠 player action · 🟣 script logic · 🟢 win · 🔴 loss · 🟡 pop-up\n\nEach box lists its source lines. Doc links open the matching file in `project/docs/`.","x":-1050,"y":2000,"width":700,"height":150}
