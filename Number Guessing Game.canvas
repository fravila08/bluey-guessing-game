{
	"nodes":[
		{"id":"71b94c42def51401","x":-648,"y":1462,"width":250,"height":60,"type":"text","text":""},
		{"id":"root","type":"text","text":"# 🐾 Bluey's Number Guessing Game\nSingle-player, plain HTML/CSS/JS.\nGuess 1–100 in 5 tries.","x":-480,"y":0,"width":360,"height":130,"color":"5"},
		{"id":"html","type":"text","text":"## 📄 index.html\n**Structure** — what is on the page","x":-1050,"y":220,"width":360,"height":90,"color":"1"},
		{"id":"css","type":"text","text":"## 🎨 style.css\n**Look** — Bluey theme & layout","x":-550,"y":220,"width":360,"height":90,"color":"4"},
		{"id":"js","type":"text","text":"## ⚙️ script.js\n**Behavior** — all game logic","x":-50,"y":220,"width":360,"height":90,"color":"6"},
		{"id":"h0","type":"text","text":"**Head** (l.6–11)\nTitle, paw favicon, Fredoka font, links `style.css`","x":-990,"y":350,"width":320,"height":105,"color":"1"},
		{"id":"h1","type":"text","text":"**Card** `main.card` (l.14–29)\n`<h1>` title + instructions (\"1 to 100\", \"5 tries\")","x":-990,"y":475,"width":320,"height":105,"color":"1"},
		{"id":"h2","type":"text","text":"**Guess form** (l.21–25)\n`#guess-form` · `#guess-input` · `#guess-button`","x":-990,"y":600,"width":320,"height":105,"color":"1"},
		{"id":"h3","type":"text","text":"**Messages** (l.27–28)\n`#feedback` (aria-live) · `#guesses-left`","x":-990,"y":725,"width":320,"height":105,"color":"1"},
		{"id":"h4","type":"text","text":"**Result pop-up** (l.31–35)\n`#result-dialog` · `#result-title` · `#result-message` · `#close-dialog`","x":-990,"y":850,"width":320,"height":105,"color":"1"},
		{"id":"h5","type":"text","text":"**Script tag** (l.37)\nLoads `script.js` at end of body","x":-990,"y":975,"width":320,"height":105,"color":"1"},
		{"id":"c0","type":"text","text":"**Theme variables** (l.1–7)\n`--bluey-blue` `--sky` `--bingo-orange` `--cream` `--ink`","x":-490,"y":350,"width":320,"height":105,"color":"4"},
		{"id":"c1","type":"text","text":"**Layout** (l.9–59)\nreset, `body`, `.card`, `h1` (clamp), `form`, `label`","x":-490,"y":475,"width":320,"height":105,"color":"4"},
		{"id":"c2","type":"text","text":"**Controls** (l.61–98)\n`input`, `button`, focus-visible, hover, disabled","x":-490,"y":600,"width":320,"height":105,"color":"4"},
		{"id":"c3","type":"text","text":"**Feedback & counter** (l.100–112)\n`.feedback`, `.guesses-left`","x":-490,"y":725,"width":320,"height":105,"color":"4"},
		{"id":"c4","type":"text","text":"**Pop-up** (l.114–143)\n`dialog`, `::backdrop`, dialog h2 / p / button","x":-490,"y":850,"width":320,"height":105,"color":"4"},
		{"id":"j0","type":"text","text":"**Constants & state** (l.1–19)\n`MAX_GUESSES` · `REPEAT_DELAY_MS` · `secretNumber` · `guessesLeft` · `previousGuesses` · `lastGuessAt` · `dialogOpenedAt`","x":10,"y":350,"width":320,"height":115,"color":"6"},
		{"id":"j1","type":"text","text":"**startGame()** (l.21–35)\nNew secret (≠ previous), reset guesses, history, UI, focus input","x":10,"y":475,"width":320,"height":115,"color":"6"},
		{"id":"j2","type":"text","text":"**endGame(won)** (l.37–49)\nDisable input, fill win/lose text, `showModal()`","x":10,"y":600,"width":320,"height":115,"color":"6"},
		{"id":"j3","type":"text","text":"**Submit handler** (l.51–96)\nValidate → count → compare → end ➜ see checks →","x":10,"y":725,"width":320,"height":115,"color":"6"},
		{"id":"j4","type":"text","text":"**Play again click** (l.98–104)\nIgnored <400 ms after pop-up opens, then `dialog.close()`","x":10,"y":850,"width":320,"height":115,"color":"6"},
		{"id":"j5","type":"text","text":"**Backdrop click** (l.105–110)\nClick on dark area closes pop-up","x":10,"y":975,"width":320,"height":115,"color":"6"},
		{"id":"j6","type":"text","text":"**`close` event** (l.112)\n`dialog` close → `startGame` (button, Esc or backdrop)","x":10,"y":1100,"width":320,"height":115,"color":"6"},
		{"id":"j7","type":"text","text":"**Page load** (l.114)\nCalls `startGame()` once","x":10,"y":1225,"width":320,"height":115,"color":"6"},
		{"id":"gtitle","type":"text","text":"### Submit handler checks (in order)","x":440,"y":280,"width":320,"height":50,"color":"6"},
		{"id":"g0","type":"text","text":"**1. Repeat-submit guard**\nLast counted guess <400 ms ago → ignored silently","x":440,"y":350,"width":340,"height":80,"color":"6"},
		{"id":"g1","type":"text","text":"**2. Invalid input**\nMust match `^\\d+$` and be 1–100 → message, **no guess used**","x":440,"y":450,"width":340,"height":80,"color":"6"},
		{"id":"g2","type":"text","text":"**3. Duplicate guess**\nAlready in `previousGuesses` → message, **no guess used**","x":440,"y":550,"width":340,"height":80,"color":"6"},
		{"id":"g3","type":"text","text":"**4. Counted guess**\nAdd to history, `guessesLeft--`, update display","x":440,"y":650,"width":340,"height":80,"color":"6"},
		{"id":"g4","type":"text","text":"**5. Correct**\n\"N is correct!\" → `endGame(true)`","x":440,"y":750,"width":340,"height":80,"color":"4"},
		{"id":"g5","type":"text","text":"**6. Wrong**\n\"too high / too low, mate!\" → clear & refocus input","x":440,"y":850,"width":340,"height":80,"color":"2"},
		{"id":"g6","type":"text","text":"**7. Out of guesses**\n`guessesLeft === 0` → `endGame(false)`","x":440,"y":950,"width":340,"height":80,"color":"1"},
		{"id":"docs","type":"text","text":"## 📚 Documentation\n`project/README.md` → `docs/`","x":900,"y":220,"width":360,"height":90,"color":"3"},
